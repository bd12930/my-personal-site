---
import { SUPPORTED_LANGS, type Lang } from '../lib/i18n';

interface Props {
  currentLang: Lang;
}

const { currentLang = 'en' } = Astro.props;
---

<div class="relative inline-block text-left" id="lang-picker-container">
  <button
    type="button"
    id="lang-picker-btn"
    class="px-2.5 py-1.5 sm:px-3 sm:py-2 bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-xl border border-slate-700 transition flex items-center space-x-1.5 shadow-sm"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span>🌐</span>
    <span class="uppercase tracking-wider font-bold">
      {currentLang === 'zh' ? '中文' : currentLang.toUpperCase()}
    </span>
    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div
    id="lang-picker-dropdown"
    class="hidden absolute right-0 mt-1.5 w-44 rounded-2xl bg-slate-800 border border-slate-700 shadow-2xl py-1.5 z-50 text-xs font-semibold text-slate-200"
    role="menu"
  >
    {SUPPORTED_LANGS.map((item) => (
      <button
        type="button"
        class={`w-full text-left px-3.5 py-2.5 flex items-center justify-between hover:bg-slate-700/70 transition ${
          currentLang === item.code ? 'text-blue-400 bg-blue-950/40 font-bold' : ''
        }`}
        data-lang-code={item.code}
      >
        <span class="flex items-center space-x-2">
          <span>{item.flag}</span>
          <span>{item.label}</span>
        </span>
        {currentLang === item.code && <span class="text-blue-400 text-xs">✓</span>}
      </button>
    ))}
  </div>
</div>

<script>
  function setupLangPicker() {
    const btn = document.getElementById('lang-picker-btn');
    const dropdown = document.getElementById('lang-picker-dropdown');
    if (!btn || !dropdown) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });

    dropdown.querySelectorAll('button[data-lang-code]').forEach((item) => {
      item.addEventListener('click', () => {
        const lang = item.getAttribute('data-lang-code');
        if (lang) {
          // Set site_lang cookie for 1 year
          document.cookie = `site_lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
          window.location.reload();
        }
      });
    });
  }

  setupLangPicker();
  document.addEventListener('astro:page-load', setupLangPicker);
</script>
