---
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { getSessionUser } from '../lib/auth';
import {
  getAllUsers,
  getUserByUsername,
  createUser,
  deleteUser,
  updateUsername,
  updateUserPassword
} from '../lib/db';

const currentUser = await getSessionUser(Astro);
if (!currentUser || currentUser.is_admin !== 1) {
  return Astro.redirect('/login');
}

let message = '';
let error = '';

const d1 = (env as any)?.DB;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');

    if (action === 'add_user') {
      const username = data.get('username')?.toString()?.trim();
      const password = data.get('password')?.toString();
      const isAdmin = data.get('is_admin') === 'true' || data.get('is_admin') === '1';

      if (!username || !password) {
        error = 'Username and password are required.';
      } else {
        const existing = await getUserByUsername(d1, username);
        if (existing) {
          error = 'Username already exists.';
        } else {
          await createUser(d1, username, password, isAdmin);
          message = `User ${username} created successfully.`;
        }
      }
    } else if (action === 'delete_user') {
      const username = data.get('username')?.toString()?.trim();

      if (!username) {
        error = 'Username is required.';
      } else if (username === currentUser.username) {
        error = 'Cannot delete your own admin account.';
      } else {
        await deleteUser(d1, username);
        message = `User ${username} deleted successfully.`;
      }
    } else if (action === 'update_username') {
      const oldUsername = data.get('old_username')?.toString()?.trim();
      const newUsername = data.get('new_username')?.toString()?.trim();

      if (!oldUsername || !newUsername) {
        error = 'Both old and new usernames are required.';
      } else {
        const existing = await getUserByUsername(d1, newUsername);
        if (existing) {
          error = 'New username is already taken.';
        } else {
          await updateUsername(d1, oldUsername, newUsername);
          message = `Username updated from ${oldUsername} to ${newUsername}.`;
        }
      }
    } else if (action === 'reset_password') {
      const targetUsername = data.get('username')?.toString()?.trim();
      const newPassword = data.get('new_password')?.toString();

      if (!targetUsername || !newPassword) {
        error = 'Target username and new password are required.';
      } else {
        const targetUser = await getUserByUsername(d1, targetUsername);
        if (!targetUser) {
          error = 'User not found.';
        } else {
          await updateUserPassword(d1, targetUsername, newPassword);
          message = `Password for ${targetUsername} successfully reset.`;
        }
      }
    }
  } catch (err: any) {
    error = err.message || 'An error occurred.';
  }
}

const users = await getAllUsers(d1);
---

<Layout>
  <div class="min-h-screen bg-slate-900 text-slate-100 font-sans flex flex-col">
    <!-- Navbar -->
    <header class="bg-slate-800 border-b border-slate-700 px-4 sm:px-6 py-4 flex flex-col sm:flex-row gap-3 sm:gap-0 justify-between sm:items-center shadow-lg">
      <div class="flex items-center space-x-3">
        <span class="text-lg sm:text-xl font-black bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent">
          Brand New Everyday
        </span>
        <span class="bg-blue-900 text-blue-200 text-xs px-2.5 py-0.5 rounded-full font-semibold border border-blue-700">
          Admin Panel
        </span>
      </div>
      <div class="flex items-center space-x-3">
        <a
          href="/"
          class="px-3.5 py-1.5 sm:px-4 sm:py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs sm:text-sm font-semibold rounded-xl transition duration-200"
        >
          Dashboard
        </a>
        <a
          href="/api/logout"
          class="px-3.5 py-1.5 sm:px-4 sm:py-2 bg-red-600 hover:bg-red-700 text-white text-xs sm:text-sm font-semibold rounded-xl transition duration-200"
        >
          Logout
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6 sm:space-y-8 min-w-0">
      {message && (
        <div class="p-4 bg-emerald-900/60 border border-emerald-500 text-emerald-200 rounded-2xl text-sm font-semibold shadow-md">
          {message}
        </div>
      )}

      {error && (
        <div class="p-4 bg-red-900/60 border border-red-500 text-red-200 rounded-2xl text-sm font-semibold shadow-md">
          {error}
        </div>
      )}

      <!-- Website Settings Section -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-xl">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3 sm:mb-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Website Settings</h2>
          <span class="text-xs bg-indigo-900 text-indigo-200 px-3 py-1 rounded-full border border-indigo-700 font-medium">Coming Soon</span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          This section is reserved for future website configurations (site metadata, theme preferences, feature flags, integrations).
        </p>
      </div>

      <!-- Add New User Section -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-xl space-y-5 sm:space-y-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Add New User</h2>
          <p class="text-slate-400 text-sm mt-1">Create a new user account with custom credentials and role.</p>
        </div>

        <form method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
          <input type="hidden" name="action" value="add_user" />
          
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Username</label>
            <input
              type="text"
              name="username"
              required
              placeholder="e.g. john"
              class="w-full px-4 py-2.5 sm:py-3 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Password</label>
            <input
              type="password"
              name="password"
              required
              placeholder="••••••••"
              class="w-full px-4 py-2.5 sm:py-3 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div class="flex items-center space-x-3 py-2 sm:py-3">
            <input
              type="checkbox"
              name="is_admin"
              value="true"
              id="is_admin_check"
              class="w-5 h-5 bg-slate-900 border-slate-700 rounded text-blue-600 focus:ring-blue-500"
            />
            <label for="is_admin_check" class="text-sm font-semibold text-slate-300">Make Admin</label>
          </div>

          <div>
            <button
              type="submit"
              class="w-full py-2.5 sm:py-3 px-6 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-sm rounded-xl shadow-md transition duration-200"
            >
              Add User
            </button>
          </div>
        </form>
      </div>

      <!-- User Management Table & Mobile Cards -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-xl space-y-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">User Management</h2>
          <p class="text-slate-400 text-sm mt-1">Manage user IDs, change usernames, reset passwords, or delete users.</p>
        </div>

        <!-- Mobile Cards (< md) -->
        <div class="space-y-4 md:hidden">
          {users.map((u) => (
            <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-4 space-y-3.5 shadow-sm">
              <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <div class="flex items-center space-x-2">
                  <span class="text-xs font-mono text-slate-500 bg-slate-800 px-2 py-0.5 rounded">#{u.id}</span>
                  <span class="font-bold text-white text-sm">{u.username}</span>
                  {u.is_admin === 1 ? (
                    <span class="text-blue-400 font-bold bg-blue-950/60 px-2 py-0.5 rounded-lg border border-blue-800/50 text-[11px]">Admin</span>
                  ) : (
                    <span class="text-slate-400 text-[11px] bg-slate-800 px-2 py-0.5 rounded-lg">User</span>
                  )}
                </div>
                {u.username !== currentUser.username && (
                  <form method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');">
                    <input type="hidden" name="action" value="delete_user" />
                    <input type="hidden" name="username" value={u.username} />
                    <button
                      type="submit"
                      class="px-2.5 py-1 bg-red-600/90 hover:bg-red-600 text-white text-xs font-semibold rounded-lg transition"
                    >
                      Delete
                    </button>
                  </form>
                )}
              </div>

              <!-- Change Username -->
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Change Username</label>
                <form method="POST" class="flex gap-2">
                  <input type="hidden" name="action" value="update_username" />
                  <input type="hidden" name="old_username" value={u.username} />
                  <input
                    type="text"
                    name="new_username"
                    placeholder="New username"
                    required
                    class="flex-1 min-w-0 px-3 py-2 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                  />
                  <button
                    type="submit"
                    class="px-3.5 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-xl transition shrink-0"
                  >
                    Change
                  </button>
                </form>
              </div>

              <!-- Reset Password -->
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Reset Password</label>
                <form method="POST" class="flex gap-2">
                  <input type="hidden" name="action" value="reset_password" />
                  <input type="hidden" name="username" value={u.username} />
                  <input
                    type="password"
                    name="new_password"
                    placeholder="New password"
                    required
                    class="flex-1 min-w-0 px-3 py-2 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                  />
                  <button
                    type="submit"
                    class="px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl transition shrink-0"
                  >
                    Reset
                  </button>
                </form>
              </div>
            </div>
          ))}
        </div>

        <!-- Desktop Table (>= md) -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-700 text-slate-400 text-xs uppercase tracking-wider">
                <th class="py-3 px-4">ID</th>
                <th class="py-3 px-4">Username</th>
                <th class="py-3 px-4">Role</th>
                <th class="py-3 px-4">Change Username</th>
                <th class="py-3 px-4">Reset Password</th>
                <th class="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-700/50 text-sm">
              {users.map((u) => (
                <tr class="hover:bg-slate-750/50">
                  <td class="py-4 px-4 text-slate-400">{u.id}</td>
                  <td class="py-4 px-4 font-semibold text-white">{u.username}</td>
                  <td class="py-4 px-4">
                    {u.is_admin === 1 ? (
                      <span class="text-blue-400 font-bold bg-blue-950/60 px-2.5 py-1 rounded-lg border border-blue-800/50 text-xs">Admin</span>
                    ) : (
                      <span class="text-slate-400 text-xs">User</span>
                    )}
                  </td>
                  
                  <!-- Change Username -->
                  <td class="py-4 px-4">
                    <form method="POST" class="inline-flex items-center space-x-2">
                      <input type="hidden" name="action" value="update_username" />
                      <input type="hidden" name="old_username" value={u.username} />
                      <input
                        type="text"
                        name="new_username"
                        placeholder="New username"
                        required
                        class="px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500 w-32"
                      />
                      <button
                        type="submit"
                        class="px-3 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-xl transition duration-150"
                      >
                        Change
                      </button>
                    </form>
                  </td>

                  <!-- Reset Password -->
                  <td class="py-4 px-4">
                    <form method="POST" class="inline-flex items-center space-x-2">
                      <input type="hidden" name="action" value="reset_password" />
                      <input type="hidden" name="username" value={u.username} />
                      <input
                        type="password"
                        name="new_password"
                        placeholder="New password"
                        required
                        class="px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500 w-32"
                      />
                      <button
                        type="submit"
                        class="px-3 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl transition duration-150"
                      >
                        Reset
                      </button>
                    </form>
                  </td>

                  <!-- Delete User -->
                  <td class="py-4 px-4 text-right">
                    {u.username !== currentUser.username && (
                      <form method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');" class="inline">
                        <input type="hidden" name="action" value="delete_user" />
                        <input type="hidden" name="username" value={u.username} />
                        <button
                          type="submit"
                          class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-xl transition duration-150 shadow"
                        >
                          Delete
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</Layout>
