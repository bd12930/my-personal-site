---
import Layout from '../layouts/Layout.astro';
import SecurityInactivityTimer from '../components/SecurityInactivityTimer.astro';
import LanguageSelector from '../components/LanguageSelector.astro';
import { env } from 'cloudflare:workers';
import { getSessionUser } from '../lib/auth';
import {
  getAllUsers,
  getUserByUsername,
  createUser,
  deleteUser,
  updateUsername,
  updateUserPassword,
  updateUserLanguage
} from '../lib/db';
import { resolveLang, getTranslations, SUPPORTED_LANGS } from '../lib/i18n';

const currentUser = await getSessionUser(Astro);
if (!currentUser || currentUser.is_admin !== 1) {
  return Astro.redirect('/login');
}

const lang = resolveLang(Astro.cookies, currentUser.preferred_lang);
const t = getTranslations(lang);

let message = '';
let error = '';

const d1 = (env as any)?.DB;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');

    if (action === 'add_user') {
      const username = data.get('username')?.toString()?.trim();
      const password = data.get('password')?.toString();
      const isAdmin = data.get('is_admin') === 'true' || data.get('is_admin') === '1';
      const preferredLang = data.get('preferred_lang')?.toString()?.trim() || 'en';

      if (!username || !password) {
        error = 'Username and password are required.';
      } else {
        const existing = await getUserByUsername(d1, username);
        if (existing) {
          error = 'Username already exists.';
        } else {
          await createUser(d1, username, password, isAdmin, preferredLang);
          message = `User ${username} created successfully.`;
        }
      }
    } else if (action === 'update_language') {
      const targetUsername = data.get('username')?.toString()?.trim();
      const newLang = data.get('preferred_lang')?.toString()?.trim();

      if (!targetUsername || !newLang) {
        error = 'Username and language selection are required.';
      } else {
        await updateUserLanguage(d1, targetUsername, newLang);
        message = `Default language for ${targetUsername} updated to ${newLang.toUpperCase()}.`;
      }
    } else if (action === 'delete_user') {
      const username = data.get('username')?.toString()?.trim();

      if (!username) {
        error = 'Username is required.';
      } else if (username === currentUser.username) {
        error = 'Cannot delete your own admin account.';
      } else {
        await deleteUser(d1, username);
        message = `User ${username} deleted successfully.`;
      }
    } else if (action === 'update_username') {
      const oldUsername = data.get('old_username')?.toString()?.trim();
      const newUsername = data.get('new_username')?.toString()?.trim();

      if (!oldUsername || !newUsername) {
        error = 'Both old and new usernames are required.';
      } else {
        const existing = await getUserByUsername(d1, newUsername);
        if (existing) {
          error = 'New username is already taken.';
        } else {
          await updateUsername(d1, oldUsername, newUsername);
          message = `Username updated from ${oldUsername} to ${newUsername}.`;
        }
      }
    } else if (action === 'reset_password') {
      const targetUsername = data.get('username')?.toString()?.trim();
      const newPassword = data.get('new_password')?.toString();

      if (!targetUsername || !newPassword) {
        error = 'Target username and new password are required.';
      } else {
        const targetUser = await getUserByUsername(d1, targetUsername);
        if (!targetUser) {
          error = 'User not found.';
        } else {
          await updateUserPassword(d1, targetUsername, newPassword);
          message = `Password for ${targetUsername} successfully reset.`;
        }
      }
    }
  } catch (err: any) {
    error = err.message || 'An error occurred.';
  }
}

const users = await getAllUsers(d1);
---

<Layout>
  <SecurityInactivityTimer />
  <div class="min-h-screen bg-slate-900 text-slate-100 font-sans flex flex-col antialiased">
    <!-- Navbar -->
    <header class="bg-slate-800 border-b border-slate-700 px-4 sm:px-6 py-4 flex flex-col sm:flex-row gap-3 sm:gap-0 justify-between sm:items-center shadow-lg">
      <div class="flex items-center space-x-3">
        <a href="/" class="text-lg sm:text-xl font-black bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent hover:opacity-90">
          Brand New Everyday
        </a>
        <span class="bg-blue-900 text-blue-200 text-xs px-2.5 py-0.5 rounded-full font-semibold border border-blue-700">
          {t.admin}
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <LanguageSelector currentLang={lang} />
        
        <a
          href="/"
          class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs sm:text-sm font-semibold rounded-xl transition duration-200"
        >
          {t.checkIn}
        </a>
        <a
          href="/history"
          class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs sm:text-sm font-semibold rounded-xl transition duration-200"
        >
          {t.history}
        </a>
        <a
          href="/guide"
          class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs sm:text-sm font-semibold rounded-xl transition duration-200"
        >
          {t.guide}
        </a>
        <a
          href="/api/logout"
          class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-red-600 hover:bg-red-700 text-white text-xs sm:text-sm font-semibold rounded-xl transition duration-200"
        >
          {t.logout}
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6 sm:space-y-8 min-w-0">
      {message && (
        <div class="p-4 bg-emerald-900/60 border border-emerald-500 text-emerald-200 rounded-2xl text-sm font-semibold shadow-md flex items-center space-x-2">
          <span>✅</span>
          <span>{message}</span>
        </div>
      )}

      {error && (
        <div class="p-4 bg-red-900/60 border border-red-500 text-red-200 rounded-2xl text-sm font-semibold shadow-md flex items-center space-x-2">
          <span>⚠️</span>
          <span>{error}</span>
        </div>
      )}

      <!-- Website Settings Section -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-xl">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3 sm:mb-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">{t.websiteSettings}</h2>
          <span class="text-xs bg-indigo-900 text-indigo-200 px-3 py-1 rounded-full border border-indigo-700 font-medium">{t.comingSoon}</span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          This section is reserved for future website configurations (site metadata, theme preferences, feature flags, integrations).
        </p>
      </div>

      <!-- Add New User Section -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-xl space-y-5 sm:space-y-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">{t.addUserTitle}</h2>
          <p class="text-slate-400 text-sm mt-1">{t.addUserDesc}</p>
        </div>

        <form method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
          <input type="hidden" name="action" value="add_user" />
          
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">{t.username}</label>
            <input
              type="text"
              name="username"
              required
              placeholder="e.g. john"
              class="w-full px-4 py-2.5 sm:py-3 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">{t.password}</label>
            <input
              type="password"
              name="password"
              required
              placeholder="••••••••"
              class="w-full px-4 py-2.5 sm:py-3 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">{t.defaultLanguage}</label>
            <select
              name="preferred_lang"
              class="w-full px-4 py-2.5 sm:py-3 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              {SUPPORTED_LANGS.map((sl) => (
                <option value={sl.code}>{sl.flag} {sl.label}</option>
              ))}
            </select>
          </div>

          <div class="flex items-center space-x-3 py-2 sm:py-3">
            <input
              type="checkbox"
              name="is_admin"
              value="true"
              id="is_admin_check"
              class="w-5 h-5 bg-slate-900 border-slate-700 rounded text-blue-600 focus:ring-blue-500"
            />
            <label for="is_admin_check" class="text-sm font-semibold text-slate-300">{t.makeAdmin}</label>
          </div>

          <div>
            <button
              type="submit"
              class="w-full py-2.5 sm:py-3 px-6 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-sm rounded-xl shadow-md transition duration-200"
            >
              {t.addUserBtn}
            </button>
          </div>
        </form>
      </div>

      <!-- User Management Table & Mobile Cards -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-xl space-y-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">{t.userManagementTitle}</h2>
          <p class="text-slate-400 text-sm mt-1">{t.userManagementDesc}</p>
        </div>

        <!-- Mobile Cards (< md) -->
        <div class="space-y-4 md:hidden">
          {users.map((u) => (
            <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-4 space-y-3.5 shadow-sm">
              <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <div class="flex items-center space-x-2">
                  <span class="text-xs font-mono text-slate-500 bg-slate-800 px-2 py-0.5 rounded">#{u.id}</span>
                  <span class="font-bold text-white text-sm">{u.username}</span>
                  {u.is_admin === 1 ? (
                    <span class="text-blue-400 font-bold bg-blue-950/60 px-2 py-0.5 rounded-lg border border-blue-800/50 text-[11px]">{t.admin}</span>
                  ) : (
                    <span class="text-slate-400 text-[11px] bg-slate-800 px-2 py-0.5 rounded-lg">{t.role}: User</span>
                  )}
                </div>
                {u.username !== currentUser.username && (
                  <form method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');">
                    <input type="hidden" name="action" value="delete_user" />
                    <input type="hidden" name="username" value={u.username} />
                    <button
                      type="submit"
                      class="px-2.5 py-1 bg-red-600/90 hover:bg-red-600 text-white text-xs font-semibold rounded-lg transition"
                    >
                      {t.delete}
                    </button>
                  </form>
                )}
              </div>

              <!-- Default Language Setting -->
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">{t.preferredLang}</label>
                <form method="POST" class="flex gap-2">
                  <input type="hidden" name="action" value="update_language" />
                  <input type="hidden" name="username" value={u.username} />
                  <select
                    name="preferred_lang"
                    class="flex-1 min-w-0 px-3 py-2 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white focus:outline-none focus:ring-1 focus:ring-blue-500"
                  >
                    {SUPPORTED_LANGS.map((sl) => (
                      <option value={sl.code} selected={(u.preferred_lang || 'en') === sl.code}>
                        {sl.flag} {sl.label}
                      </option>
                    ))}
                  </select>
                  <button
                    type="submit"
                    class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl transition shrink-0"
                  >
                    {t.saveLang}
                  </button>
                </form>
              </div>

              <!-- Change Username -->
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">{t.changeUsername}</label>
                <form method="POST" class="flex gap-2">
                  <input type="hidden" name="action" value="update_username" />
                  <input type="hidden" name="old_username" value={u.username} />
                  <input
                    type="text"
                    name="new_username"
                    placeholder="New username"
                    required
                    class="flex-1 min-w-0 px-3 py-2 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                  />
                  <button
                    type="submit"
                    class="px-3.5 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-xl transition shrink-0"
                  >
                    {t.change}
                  </button>
                </form>
              </div>

              <!-- Reset Password -->
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">{t.resetPassword}</label>
                <form method="POST" class="flex gap-2">
                  <input type="hidden" name="action" value="reset_password" />
                  <input type="hidden" name="username" value={u.username} />
                  <input
                    type="password"
                    name="new_password"
                    placeholder="New password"
                    required
                    class="flex-1 min-w-0 px-3 py-2 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                  />
                  <button
                    type="submit"
                    class="px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl transition shrink-0"
                  >
                    {t.reset}
                  </button>
                </form>
              </div>
            </div>
          ))}
        </div>

        <!-- Desktop Table (>= md) -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-700 text-slate-400 text-xs uppercase tracking-wider">
                <th class="py-3 px-4">ID</th>
                <th class="py-3 px-4">{t.username}</th>
                <th class="py-3 px-4">{t.role}</th>
                <th class="py-3 px-4">{t.preferredLang}</th>
                <th class="py-3 px-4">{t.changeUsername}</th>
                <th class="py-3 px-4">{t.resetPassword}</th>
                <th class="py-3 px-4 text-right">{t.actions}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-700/50 text-sm">
              {users.map((u) => (
                <tr class="hover:bg-slate-750/50">
                  <td class="py-4 px-4 text-slate-400">{u.id}</td>
                  <td class="py-4 px-4 font-semibold text-white">{u.username}</td>
                  <td class="py-4 px-4">
                    {u.is_admin === 1 ? (
                      <span class="text-blue-400 font-bold bg-blue-950/60 px-2.5 py-1 rounded-lg border border-blue-800/50 text-xs">Admin</span>
                    ) : (
                      <span class="text-slate-400 text-xs">User</span>
                    )}
                  </td>

                  <!-- Preferred Language Setting -->
                  <td class="py-4 px-4">
                    <form method="POST" class="inline-flex items-center space-x-2">
                      <input type="hidden" name="action" value="update_language" />
                      <input type="hidden" name="username" value={u.username} />
                      <select
                        name="preferred_lang"
                        class="px-2.5 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white focus:outline-none focus:ring-1 focus:ring-blue-500 w-36"
                      >
                        {SUPPORTED_LANGS.map((sl) => (
                          <option value={sl.code} selected={(u.preferred_lang || 'en') === sl.code}>
                            {sl.flag} {sl.label}
                          </option>
                        ))}
                      </select>
                      <button
                        type="submit"
                        class="px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl transition duration-150"
                      >
                        {t.saveLang}
                      </button>
                    </form>
                  </td>
                  
                  <!-- Change Username -->
                  <td class="py-4 px-4">
                    <form method="POST" class="inline-flex items-center space-x-2">
                      <input type="hidden" name="action" value="update_username" />
                      <input type="hidden" name="old_username" value={u.username} />
                      <input
                        type="text"
                        name="new_username"
                        placeholder="New username"
                        required
                        class="px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500 w-32"
                      />
                      <button
                        type="submit"
                        class="px-3 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-xl transition duration-150"
                      >
                        {t.change}
                      </button>
                    </form>
                  </td>

                  <!-- Reset Password -->
                  <td class="py-4 px-4">
                    <form method="POST" class="inline-flex items-center space-x-2">
                      <input type="hidden" name="action" value="reset_password" />
                      <input type="hidden" name="username" value={u.username} />
                      <input
                        type="password"
                        name="new_password"
                        placeholder="New password"
                        required
                        class="px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500 w-32"
                      />
                      <button
                        type="submit"
                        class="px-3 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl transition duration-150"
                      >
                        {t.reset}
                      </button>
                    </form>
                  </td>

                  <!-- Delete User -->
                  <td class="py-4 px-4 text-right">
                    {u.username !== currentUser.username && (
                      <form method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');" class="inline">
                        <input type="hidden" name="action" value="delete_user" />
                        <input type="hidden" name="username" value={u.username} />
                        <button
                          type="submit"
                          class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-xl transition duration-150 shadow"
                        >
                          {t.delete}
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</Layout>
