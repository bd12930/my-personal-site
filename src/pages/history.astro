---
import Layout from '../layouts/Layout.astro';
import SecurityInactivityTimer from '../components/SecurityInactivityTimer.astro';
import { env } from 'cloudflare:workers';
import { getSessionUser } from '../lib/auth';
import { getCheckIns, deleteCheckIn, type CheckIn } from '../lib/db';

const user = await getSessionUser(Astro);
if (!user) {
  return Astro.redirect('/login');
}

const d1 = (env as any)?.DB;

let message = '';
let error = '';

// Handle Delete Entry action
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');

    if (action === 'delete_checkin') {
      const checkInId = Number(data.get('checkin_id'));
      if (checkInId) {
        // Enforce strict user isolation: only delete if user_id matches logged-in user
        const success = await deleteCheckIn(d1, checkInId, user.id);
        if (success) {
          message = 'Check-in entry deleted successfully.';
        } else {
          error = 'Could not delete entry (permission denied or entry not found).';
        }
      }
    }
  } catch (err: any) {
    error = err.message || 'An error occurred while deleting the entry.';
  }
}

const checkins: CheckIn[] = await getCheckIns(d1, 150);

const STATE_CONFIG: Record<string, { emoji: string; bg: string; text: string; border: string }> = {
  'Very Unpleasant': { emoji: '😣', bg: 'bg-red-950/60', text: 'text-red-300', border: 'border-red-800' },
  'Unpleasant': { emoji: '🙁', bg: 'bg-orange-950/60', text: 'text-orange-300', border: 'border-orange-800' },
  'Slightly Unpleasant': { emoji: '😕', bg: 'bg-amber-950/60', text: 'text-amber-300', border: 'border-amber-800' },
  'Neutral': { emoji: '😐', bg: 'bg-slate-800', text: 'text-slate-300', border: 'border-slate-700' },
  'Slightly Pleasant': { emoji: '🙂', bg: 'bg-teal-950/60', text: 'text-teal-300', border: 'border-teal-800' },
  'Pleasant': { emoji: '😊', bg: 'bg-emerald-950/60', text: 'text-emerald-300', border: 'border-emerald-800' },
  'Very Pleasant': { emoji: '😄', bg: 'bg-sky-950/60', text: 'text-sky-300', border: 'border-sky-800' },
};
---

<Layout>
  <SecurityInactivityTimer />
  <div class="min-h-screen bg-slate-900 text-slate-100 font-sans flex flex-col antialiased">
    
    <!-- Top Navigation Header -->
    <header class="bg-slate-800/95 backdrop-blur-md border-b border-slate-700/80 sticky top-0 z-30 px-4 sm:px-6 py-3.5 flex flex-wrap justify-between items-center gap-3 shadow-md">
      <div class="flex items-center space-x-2.5">
        <a href="/" class="flex items-center space-x-2 hover:opacity-90 transition">
          <span class="w-8 h-8 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-md shadow-blue-500/20">
            ☀️
          </span>
          <span class="text-lg sm:text-xl font-black bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-300 bg-clip-text text-transparent">
            Brand New Everyday
          </span>
        </a>
        <span class="text-xs bg-slate-700/80 text-slate-300 px-2.5 py-0.5 rounded-full font-medium border border-slate-600">
          History
        </span>
      </div>

      <nav class="flex items-center space-x-2 sm:space-x-3 text-xs sm:text-sm font-semibold">
        <a
          href="/"
          class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-slate-700/80 hover:bg-slate-700 text-slate-200 rounded-xl border border-slate-600/80 transition flex items-center space-x-1.5"
        >
          <span>✍️</span>
          <span>New Check-In</span>
        </a>
        <a
          href="/guide"
          class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-slate-700/80 hover:bg-slate-700 text-slate-200 rounded-xl border border-slate-600/80 transition flex items-center space-x-1.5"
        >
          <span>💡</span>
          <span>Guide</span>
        </a>
        {user.is_admin === 1 && (
          <a
            href="/admin"
            class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-indigo-900/80 hover:bg-indigo-800 text-indigo-200 rounded-xl border border-indigo-700/60 transition"
          >
            Admin
          </a>
        )}
        <a
          href="/api/logout"
          class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-red-600/80 hover:bg-red-600 text-white rounded-xl transition shadow-sm"
        >
          Logout
        </a>
      </nav>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 sm:p-6 space-y-6 min-w-0">
      
      <!-- Page Title & Header Info -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center space-x-2.5">
            <span>📜</span>
            <span>Family Check-In History</span>
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Browse updates, celebrate answers to prayer, and encourage one another.
          </p>
        </div>

        <a
          href="/"
          class="self-start sm:self-auto px-4 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-xs sm:text-sm font-bold rounded-xl shadow-md shadow-blue-500/20 transition flex items-center space-x-1.5"
        >
          <span>+</span>
          <span>Add Check-In</span>
        </a>
      </div>

      <!-- Feedback Alerts -->
      {message && (
        <div class="p-4 bg-emerald-950/80 border border-emerald-500 text-emerald-200 rounded-2xl text-sm font-semibold shadow-md flex items-center space-x-2.5">
          <span>✅</span>
          <span>{message}</span>
        </div>
      )}

      {error && (
        <div class="p-4 bg-red-950/80 border border-red-500 text-red-200 rounded-2xl text-sm font-semibold shadow-md flex items-center space-x-2.5">
          <span>⚠️</span>
          <span>{error}</span>
        </div>
      )}

      <!-- Empty State -->
      {checkins.length === 0 && (
        <div class="bg-slate-800/80 border border-slate-700 rounded-3xl p-8 sm:p-12 text-center space-y-4 shadow-xl">
          <div class="w-16 h-16 bg-blue-900/40 text-blue-300 rounded-full flex items-center justify-center mx-auto text-3xl">
            🕊️
          </div>
          <h2 class="text-xl font-bold text-white">No Family Check-Ins Yet</h2>
          <p class="text-slate-400 text-sm max-w-md mx-auto">
            Be the very first to share your heart today! It takes just a few seconds to let your family know how you are doing.
          </p>
          <div class="pt-2">
            <a
              href="/"
              class="inline-flex items-center space-x-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-sm rounded-2xl shadow-lg shadow-blue-500/25 transition"
            >
              <span>☀️</span>
              <span>Post First Check-In</span>
            </a>
          </div>
        </div>
      )}

      <!-- Check-Ins Timeline Feed (Reverse Chronological) -->
      <div class="space-y-5">
        {checkins.map((entry) => {
          const isOwner = entry.user_id === user.id || entry.username === user.username;
          const moodConfig = STATE_CONFIG[entry.state_of_mind] || STATE_CONFIG['Pleasant'];
          const dateObj = new Date(entry.created_at);
          const dateStr = dateObj.toLocaleDateString(undefined, {
            weekday: 'short',
            month: 'short',
            day: 'numeric',
            year: 'numeric'
          });
          const timeStr = dateObj.toLocaleTimeString(undefined, {
            hour: '2-digit',
            minute: '2-digit'
          });

          return (
            <article class="bg-slate-800/90 border border-slate-700/80 rounded-2xl sm:rounded-3xl p-5 sm:p-6 shadow-xl space-y-4 transition hover:border-slate-600">
              
              <!-- Card Header: Author, Date, Mood Badge, and Actions -->
              <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-700/70">
                <div class="flex items-center space-x-3">
                  <!-- User Avatar Badge -->
                  <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-blue-500/30 to-indigo-600/30 border border-blue-400/40 flex items-center justify-center text-blue-200 font-extrabold text-base shadow-inner">
                    {entry.username.charAt(0).toUpperCase()}
                  </div>

                  <div>
                    <div class="flex items-center space-x-2">
                      <span class="font-bold text-white text-base">{entry.username}</span>
                      {isOwner && (
                        <span class="text-[10px] bg-slate-700 text-slate-300 px-2 py-0.5 rounded-full font-semibold">
                          You
                        </span>
                      )}
                    </div>
                    <span class="text-xs text-slate-400 font-mono">
                      {dateStr} at {timeStr}
                    </span>
                  </div>
                </div>

                <!-- Mood Badge & Owner Action Buttons -->
                <div class="flex items-center space-x-2">
                  <span class={`inline-flex items-center space-x-1.5 px-3 py-1 rounded-xl text-xs font-semibold border ${moodConfig.bg} ${moodConfig.text} ${moodConfig.border}`}>
                    <span>{moodConfig.emoji}</span>
                    <span>{entry.state_of_mind}</span>
                  </span>

                  <!-- Strict User Isolation: Edit/Delete Only Rendered for Owner -->
                  {isOwner && (
                    <div class="flex items-center space-x-1.5 pl-1">
                      <a
                        href={`/checkin/edit/${entry.id}`}
                        class="px-2.5 py-1 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-lg transition"
                        title="Edit your check-in"
                      >
                        Edit
                      </a>

                      <form
                        method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this check-in entry?');"
                        class="inline"
                      >
                        <input type="hidden" name="action" value="delete_checkin" />
                        <input type="hidden" name="checkin_id" value={entry.id} />
                        <button
                          type="submit"
                          class="px-2.5 py-1 bg-red-600/80 hover:bg-red-600 text-white text-xs font-semibold rounded-lg transition shadow-sm"
                          title="Delete your check-in"
                        >
                          Delete
                        </button>
                      </form>
                    </div>
                  )}
                </div>
              </div>

              <!-- Content Grid: 4 Styled Pastel Fields -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1 text-sm">
                
                <!-- Struggle (Soft Rose / Blush) -->
                <div class="p-3.5 bg-rose-950/20 border border-rose-500/30 rounded-2xl space-y-1">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-rose-300 flex items-center space-x-1">
                    <span>🥀</span>
                    <span>Struggle</span>
                  </div>
                  <p class="text-slate-200 whitespace-pre-wrap leading-relaxed text-xs sm:text-sm">
                    {entry.struggle || 'None'}
                  </p>
                </div>

                <!-- Count Blessing (Soft Amber / Gold) -->
                <div class="p-3.5 bg-amber-950/20 border border-amber-500/30 rounded-2xl space-y-1">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-amber-300 flex items-center space-x-1">
                    <span>✨</span>
                    <span>Count Blessing</span>
                  </div>
                  <p class="text-slate-200 whitespace-pre-wrap leading-relaxed text-xs sm:text-sm">
                    {entry.count_blessing || "I'm loved by God"}
                  </p>
                </div>

                <!-- Prayer Request (Soft Sky Blue / Indigo) -->
                <div class="p-3.5 bg-sky-950/20 border border-sky-500/30 rounded-2xl space-y-1">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-sky-300 flex items-center space-x-1">
                    <span>🙏</span>
                    <span>Prayer Request</span>
                  </div>
                  <p class="text-slate-200 whitespace-pre-wrap leading-relaxed text-xs sm:text-sm">
                    {entry.prayer_request || "Lord's Prayer"}
                  </p>
                </div>

                <!-- Any Other Business (Soft Sage Green) -->
                <div class="p-3.5 bg-emerald-950/20 border border-emerald-500/30 rounded-2xl space-y-1">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-300 flex items-center space-x-1">
                    <span>💬</span>
                    <span>Any Other Business</span>
                  </div>
                  <p class="text-slate-200 whitespace-pre-wrap leading-relaxed text-xs sm:text-sm">
                    {entry.aob || '—'}
                  </p>
                </div>

              </div>

              <!-- Attached Reformed Devotion (Collapsible / Snippet) -->
              {entry.devotion_title && (
                <div class="mt-2 pt-3 border-t border-slate-700/60">
                  <details class="group text-xs text-slate-300">
                    <summary class="cursor-pointer list-none flex items-center justify-between text-indigo-300 hover:text-indigo-200 select-none py-1">
                      <span class="font-semibold flex items-center space-x-1.5">
                        <span>📖</span>
                        <span>Devotion: {entry.devotion_title} ({entry.devotion_passage})</span>
                      </span>
                      <span class="group-open:rotate-180 transition-transform duration-200 text-slate-400">▼</span>
                    </summary>
                    <div class="mt-2 p-3 bg-indigo-950/30 border border-indigo-800/40 rounded-xl space-y-2 text-xs leading-relaxed text-slate-300">
                      <p>{entry.devotion_text}</p>
                    </div>
                  </details>
                </div>
              )}

            </article>
          );
        })}
      </div>

    </main>
  </div>
</Layout>
