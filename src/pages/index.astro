---
import Layout from '../layouts/Layout.astro';
import { getSessionUser } from '../lib/auth';
import { getAllUsers } from '../lib/db';

const user = await getSessionUser(Astro);
if (!user) {
  return Astro.redirect('/login');
}

let message = '';
let error = '';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;

if (user.is_admin === 1 && Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');

    if (action === 'reset_password') {
      const targetUsername = data.get('username')?.toString();
      const newPassword = data.get('new_password')?.toString();

      if (!targetUsername || !newPassword) {
        error = 'Target username and new password are required.';
      } else {
        const response = await fetch(new URL('/api/admin/reset-password', Astro.request.url), {
          method: 'POST',
          headers: Astro.request.headers,
          body: data,
        });

        const json = await response.json();
        if (response.ok) {
          message = json.message || `Password successfully updated for ${targetUsername}.`;
        } else {
          error = json.message || 'Failed to update password.';
        }
      }
    }
  } catch (err: any) {
    error = err.message || 'An error occurred.';
  }
}

const allUsers = user.is_admin === 1 ? await getAllUsers(d1) : [];
---

<Layout>
  <div class="min-h-screen bg-gray-900 text-gray-100 flex flex-col">
    <!-- Header Navbar -->
    <header class="bg-gray-800 border-b border-gray-700 px-6 py-4 flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <span class="text-xl font-bold bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
          Brand New Everyday
        </span>
        {user.is_admin === 1 && (
          <span class="bg-blue-900 text-blue-200 text-xs px-2.5 py-0.5 rounded-full font-semibold border border-blue-700">
            Admin
          </span>
        )}
      </div>
      <div class="flex items-center space-x-4">
        <span class="text-gray-300 text-sm">
          Logged in as <strong class="text-white">{user.username}</strong>
        </span>
        {user.is_admin === 1 && (
          <a
            href="/admin"
            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg transition duration-200"
          >
            Admin Panel
          </a>
        )}
        <a
          href="/api/logout"
          class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg transition duration-200"
        >
          Logout
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-5xl w-full mx-auto p-6 space-y-6">
      {message && (
        <div class="p-4 bg-green-900/50 border border-green-500 text-green-200 rounded-lg text-sm">
          {message}
        </div>
      )}

      {error && (
        <div class="p-4 bg-red-900/50 border border-red-500 text-red-200 rounded-lg text-sm">
          {error}
        </div>
      )}

      <div class="bg-gray-800 border border-gray-700 rounded-xl p-6 shadow-md">
        <h2 class="text-2xl font-semibold mb-2">Welcome back, {user.username}!</h2>
        <p class="text-gray-400 text-sm">
          {user.is_admin === 1
            ? 'You are logged in as the administrator (budi). You can manage user credentials below.'
            : 'You are successfully authenticated. If you forgot your password, please contact the administrator (budi) to reset it.'}
        </p>
      </div>

      {user.is_admin === 1 && (
        <div class="bg-gray-800 border border-gray-700 rounded-xl p-6 shadow-md space-y-6">
          <div>
            <h3 class="text-xl font-semibold text-gray-200">User Management & Password Reset</h3>
            <p class="text-gray-400 text-sm mt-1">
              Overwrite passwords for any user in case they forgot their credentials.
            </p>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-gray-700 text-gray-400 text-xs uppercase tracking-wider">
                  <th class="py-3 px-4">ID</th>
                  <th class="py-3 px-4">Username</th>
                  <th class="py-3 px-4">Role</th>
                  <th class="py-3 px-4 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-700/50 text-sm">
                {allUsers.map((u) => (
                  <tr class="hover:bg-gray-750">
                    <td class="py-3 px-4 text-gray-400">{u.id}</td>
                    <td class="py-3 px-4 font-medium text-white">{u.username}</td>
                    <td class="py-3 px-4">
                      {u.is_admin === 1 ? (
                        <span class="text-blue-400 font-semibold">Admin</span>
                      ) : (
                        <span class="text-gray-400">User</span>
                      )}
                    </td>
                    <td class="py-3 px-4 text-right">
                      <form method="POST" class="inline-flex items-center space-x-2 justify-end">
                        <input type="hidden" name="action" value="reset_password" />
                        <input type="hidden" name="username" value={u.username} />
                        <input
                          type="password"
                          name="new_password"
                          placeholder="New password"
                          required
                          class="px-3 py-1.5 bg-gray-900 border border-gray-700 rounded text-xs text-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                        />
                        <button
                          type="submit"
                          class="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded transition duration-150"
                        >
                          Reset Pwd
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </main>
  </div>
</Layout>
